{
  "name": "flowtools",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "plugins"
    ],
    "catalog": {
      "@heroui/react": "^3.0.3",
      "@heroui/styles": "^3.0.3",
      "@tanstack/react-router": "^1.169.1",
      "@types/node": "^25.6.0",
      "@types/react": "^19.2.14",
      "@types/react-dom": "^19.2.3",
      "@vitejs/plugin-react": "^6.0.3",
      "babel-plugin-react-compiler": "^1.0.0",
      "motion": "^12.38.0",
      "oxfmt": "^0.51.0",
      "oxlint": "^1.66.0",
      "oxlint-tailwindcss": "^0.8.0",
      "oxlint-tsgolint": "^0.23.0",
      "react": "^19.2.5",
      "react-dom": "^19.2.5",
      "tailwindcss": "^4.2.4",
      "@tailwindcss/vite": "^4.2.4",
      "tsdown": "^0.22.0",
      "typescript": "^6.0.3",
      "vite": "^8.0.10",
      "zod": "^4.4.2",
      "zustand": "^5.0.12",
      "es-toolkit": "^1.46.1"
    }
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=@flowtools/sdk --filter=@flowtools/ui --filter=@flowtools/cli --filter=@flowtools/plugins",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@flowtools/web",
    "dev:desktop": "bun run --cwd apps/desktop tauri dev",
    "build:desktop": "bun run --cwd apps/desktop tauri build",
    "lint": "oxlint --type-aware --type-check scripts/docs-check.ts scripts/docs-check.test.ts scripts/inspect-html-plugins.ts scripts/verify-plugin-catalog.ts scripts/catalog.test.ts scripts/generate-manifests.ts scripts/generate-manifests.test.ts scripts/generate-command-docs.ts scripts/generate-command-docs.test.ts scripts/production-artifacts.ts scripts/production-artifacts.test.ts scripts/verify-production-entrypoints.ts scripts/verify-manifests.ts scripts/verify-manifests.test.ts && turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "turbo run format",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "smoke:plugins": "bun run build:packages && bun run --cwd plugins smoke:plugins",
    "lint:staged": "lint-staged",
    "prepare": "husky",
    "generate:manifests": "bun run scripts/generate-manifests.ts",
    "generate:command-docs": "bun run scripts/generate-command-docs.ts",
    "verify:command-docs": "bun run scripts/generate-command-docs.ts --check",
    "generate:hosts": "bun run --cwd packages/runtime-core generate && bun run --cwd apps/web-vite generate:routes && bun run --cwd apps/desktop generate",
    "inspect:html-plugins": "bun run scripts/inspect-html-plugins.ts",
    "verify:plugin-catalog": "bun run scripts/verify-plugin-catalog.ts",
    "verify:production-entrypoints": "bun run scripts/verify-production-entrypoints.ts",
    "docs:check": "bun run scripts/docs-check.ts",
    "verify:manifests": "bun run scripts/verify-manifests.ts",
    "verify:workspace-tasks": "bun run scripts/verify-workspace-tasks.ts",
    "verify:runtime-contracts": "bun run --cwd packages/runtime-core verify:bindings"
  },
  "dependencies": {
    "es-toolkit": "catalog:",
    "motion": "catalog:"
  },
  "devDependencies": {
    "@tanstack/router-cli": "1.167.17",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native-preview": "^7.0.0-dev.20260421.2",
    "babel-plugin-react-compiler": "catalog:",
    "bun-types": "^1.3.13",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tailwindcss": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsdown": "catalog:",
    "turbo": "^2.9.8",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{json,md,css,scss,html,yml,yaml}": "oxfmt"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "bun@1.3.14"
}
