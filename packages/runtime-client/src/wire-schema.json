    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "outcome": {
        "$ref": "#/$defs/Outcome"
      },
      "requestId": {
        "type": "string"
      },
      "version": {
        "format": "uint16",
        "maximum": 65535,
        "minimum": 0,
        "type": "integer"
      }
    },
    "required": [
      "version",
      "requestId",
      "outcome"
    ],
