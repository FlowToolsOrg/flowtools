{
  "name": "@flow-tool/ui-test",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174",
    "build": "tsc -b && vite build",
    "lint": "oxlint --fix",
    "format": "oxfmt",
    "check-types": "tsc -b",
    "test": "bun test:browser",
    "test:watch": "vitest",
    "test:browser": "vitest --config=vitest.browser.config.ts --ui"
  },
  "dependencies": {
    "@flow-tool/ui": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/ui": "4.0.18",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.48.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.0-beta.13",
    "vitest": "^4.0.18",
    "vitest-browser-react": "^2.0.5"
  },
  "overrides": {
    "vite": "^8.0.0-beta.13"
  }
}
