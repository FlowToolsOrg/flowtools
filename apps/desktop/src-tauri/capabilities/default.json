{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Explicit local main-window commands for the fixed T1 host; no plugin execution grant",
  "windows": ["main"],
  "permissions": [
    "allow-get-plugins",
    "allow-get-plugin",
    "allow-add-plugin",
    "allow-update-plugin",
    "allow-enable-plugin",
    "allow-disable-plugin",
    "allow-remove-plugin",
    "allow-managed-runtime",
    "allow-managed-runtime-disconnect",
    "allow-managed-runtime-storage",
    "allow-managed-runtime-control",
    "core:app:allow-version",
    "core:app:allow-tauri-version",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:resources:allow-close",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }]
    },
    "fs:allow-read-text-file",
    "fs:deny-default",
    "dialog:allow-open",
    "dialog:allow-save",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    "store:allow-load",
    "store:allow-get-store",
    "store:allow-set",
    "store:allow-get",
    "store:allow-delete",
    "store:allow-save"
  ]
}
