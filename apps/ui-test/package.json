{
  "name": "@flowtools/ui-test",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174",
    "build": "tsgo -b && vite build",
    "lint": "oxlint --type-aware --type-check",
    "lint:fix": "oxlint --fix --type-aware --type-check",
    "format": "oxfmt",
    "check-types": "tsgo -b",
    "test": "vitest run --config vitest.browser.config.ts",
    "test:watch": "vitest --config vitest.browser.config.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "dependencies": {
    "@flowtools/ui": "workspace:*",
    "@heroui/react": "catalog:",
    "@heroui/styles": "catalog:",
