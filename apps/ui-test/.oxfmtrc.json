{
  "$schema": "../../node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": ["node_modules/**", "dist/**", "coverage/**"],
  "tabWidth": 2,
  "useTabs": false,
  "endOfLine": "lf",
  "quoteStyle": "single",
  "semi": false,
  "singleQuote": true,
  "trailingComma": "es5",
  "printWidth": 80,
  "bracketSpacing": true,
  "arrowParens": "avoid"
}
