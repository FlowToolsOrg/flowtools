{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["node"],
    "paths": {
      "@flowtools/sdk": ["../packages/sdk/src/index.ts"],
      "@flowtools/sdk/*": ["../packages/sdk/src/*"],
      "@flowtools/ui": ["../packages/ui/src/index.ts"],
      "@flowtools/ui/*": ["../packages/ui/src/*"]
    },
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true
  },
  "include": ["./*/index.tsx", "./*/index.ts"],
  "exclude": ["../node_modules", "../dist", "../build"]
}
