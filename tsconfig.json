{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleDetection": "force",
    "types": ["node"]
  },
  "references": [
    {
      "path": "./packages/ui"
    }
  ],
  "include": ["./scripts/*.ts"],
  "exclude": ["node_modules", "dist", "build"]
}
