{
  "name": "@flowtools/runtime-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "lint": "oxlint --type-aware --type-check src && oxlint --type-aware --type-check --tsconfig tsconfig.test.json test",
    "check-types": "tsgo --noEmit && tsgo --noEmit -p tsconfig.test.json",
    "test": "bun run build && bun test test"
  },
  "dependencies": {
    "@flowtools/sdk": "workspace:*",
    "ajv": "8.17.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "bun-types": "^1.3.13"
  }
}
