{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "paths": {
      "@flowtools/sdk": ["../packages/sdk/src/index.ts"],
      "@flowtools/sdk/*": ["../packages/sdk/src/*"],
      "@flowtools/ui": ["../packages/ui/src/index.ts"],
      "@flowtools/ui/*": ["../packages/ui/src/*"],
      "react": ["../apps/web-vite/node_modules/@types/react/index.d.ts"],
      "react/jsx-runtime": [
        "../apps/web-vite/node_modules/@types/react/jsx-runtime.d.ts"
      ],
      "react/jsx-dev-runtime": [
        "../apps/web-vite/node_modules/@types/react/jsx-dev-runtime.d.ts"
      ]
    },
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true
  },
  "include": ["./*/index.tsx", "./*/index.ts"],
  "exclude": ["../node_modules", "../dist", "../build"]
}
