{
  "name": "@flowtools/ui-test",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174",
    "build": "tsgo -b && vite build",
    "lint": "oxlint --fix",
    "format": "oxfmt",
    "check-types": "tsgo --noEmit",
    "test": "bun test:browser",
    "test:watch": "vitest",
    "test:browser": "vitest --config=vitest.browser.config.ts --ui"
  },
  "dependencies": {
    "@flowtools/ui": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "^4.0.18",
    "vitest-browser-react": "^2.0.5"
  },
  "overrides": {
    "vite": "^8.0.0-beta.13"
  }
}
