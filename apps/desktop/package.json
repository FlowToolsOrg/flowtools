{
  "name": "@flowtools/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run generate && tsc && vite build",
    "generate": "bun run generate:routes && bun run generate:bindings",
    "generate:routes": "bun --bun run tsr generate",
    "generate:bindings": "cargo run --locked --manifest-path src-tauri/Cargo.toml --features codegen --bin export-bindings",
    "lint": "oxlint --type-aware --type-check",
    "lint:fix": "oxlint --fix --type-aware --type-check",
    "format": "oxfmt",
    "check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "bun test test ../../scripts && bun run test/rust-test-inventory.ts && cargo test --locked --features codegen --lib --test bindings --manifest-path src-tauri/Cargo.toml",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@flowtools/plugins": "workspace:*",
    "@flowtools/runtime": "workspace:*",
    "@flowtools/runtime-client": "workspace:*",
    "@flowtools/sdk": "workspace:*",
    "@flowtools/ui": "workspace:*",
    "@heroui/react": "catalog:",
    "@heroui/styles": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-router": "^1.170.16",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "~2",
    "@tauri-apps/plugin-dialog": "~2",
    "@tauri-apps/plugin-fs": "~2",
    "@tauri-apps/plugin-notification": "~2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-sql": "~2",
    "@tauri-apps/plugin-store": "~2",
    "motion": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "^0.2.3",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/router-plugin": "^1.168.18",
    "@tauri-apps/cli": "^2",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "babel-plugin-react-compiler": "^1.0.0",
    "bun-types": "^1.3.13",
    "code-inspector-plugin": "^1.6.2",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
