                "type": "boolean"
              }
            },
            "required": [
              "success",
              "error"
            ],
            "type": "object"
          }
        ],
        "description": "Versioned extension of PluginExecutionResult; a receipt is a different type.",
        "properties": {
          "durationMs": {
            "format": "double",
            "type": "number"
          },
          "finishedAt": {
            "format": "double",
            "type": "number"
          },
          "formatVersion": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "inputSummary": {
            "$ref": "#/$defs/InputSummary"
