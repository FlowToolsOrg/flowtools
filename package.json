{
  "name": "flowtools",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "plugins"
    ],
    "catalog": {
      "@heroui/react": "^3.0.3",
      "@heroui/styles": "^3.0.3",
      "@tanstack/react-router": "^1.169.1",
      "@types/node": "^25.6.0",
      "@types/react": "^19.2.14",
      "@types/react-dom": "^19.2.3",
      "@vitejs/plugin-react": "^6.0.1",
      "babel-plugin-react-compiler": "^1.0.0",
      "motion": "^12.38.0",
      "oxfmt": "^0.47.0",
      "oxlint": "^1.62.0",
      "oxlint-tailwindcss": "^0.6.3",
      "oxlint-tsgolint": "^0.22.1",
      "react": "^19.2.5",
      "react-dom": "^19.2.5",
      "tailwindcss": "^4.2.4",
      "tsdown": "^0.21.10",
      "typescript": "^6.0.3",
      "vite": "^8.0.10",
      "zod": "^4.4.2",
      "zustand": "^5.0.12",
      "es-toolkit": "^1.46.1"
    }
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "lint:staged": "lint-staged",
    "prepare": "husky",
    "generate:manifests": "bun run scripts/generate-manifests.ts"
  },
  "dependencies": {
    "es-toolkit": "catalog:",
    "motion": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "bun-types": "^1.3.13",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tailwindcss": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsdown": "catalog:",
    "turbo": "^2.9.8",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{json,md,css,scss,html,yml,yaml}": "oxfmt"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "bun@1.3.1"
}
