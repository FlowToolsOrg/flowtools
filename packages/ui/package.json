{
  "name": "@flowtools/ui",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js"
    }
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "dev": "tsdown --config tsdown.config.ts --watch",
    "lint": "oxlint --type-aware --type-check",
    "lint:fix": "oxlint --fix --type-aware --type-check",
    "format": "oxfmt",
    "generate:component": "turbo gen react-component",
    "check-types": "tsgo --noEmit && tsgo --project tsconfig.test.json --noEmit",
    "test": "bun run build && bun run test:consumer-types && bun test test",
    "test:consumer-types": "tsgo --project test/consumer/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@flowtools/sdk": "workspace:*"
  },
  "devDependencies": {
    "@heroui/react": "catalog:",
    "@heroui/styles": "catalog:",
    "bun-types": "^1.3.13",
    "motion": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:"
  },
  "peerDependencies": {
    "@heroui/react": "catalog:",
    "@heroui/styles": "catalog:",
    "motion": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:"
  },
  "peerDependenciesMeta": {
    "@heroui/react": {
      "optional": false
    },
    "@heroui/styles": {
      "optional": false
    },
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    },
    "tailwindcss": {
      "optional": false
    }
  }
}
