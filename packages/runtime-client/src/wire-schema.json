          "pluginId": {
            "type": "string"
          },
          "pluginVersion": {
            "type": "string"
          },
          "runId": {
            "type": "string"
          },
          "startedAt": {
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "formatVersion",
          "runId",
          "pluginId",
          "pluginVersion",
          "startedAt",
          "finishedAt",
          "durationMs",
